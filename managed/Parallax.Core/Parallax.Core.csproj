<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- .NET 3.5 against Unity 2018.4 engine assemblies: one build loads in both the old (.NET 3.5) and new
         (.NET 4.x) Mono runtimes. Newer engine APIs are reached by reflection. -->
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildThisFileDirectory)..\..\build\deps\bepinex5\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <!-- Unity 2018.4 engine reference assemblies from the BepInEx feed (NuGet.Config): no Unity install needed. -->
    <PackageReference Include="UnityEngine.Modules" Version="2018.4.36" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
</Project>
