<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- IL2CPP build of the same sources: BepInEx 6 hosts .NET 6 and reaches the game through Il2CppInterop. -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
    <AssemblyName>Parallax.Core</AssemblyName>
    <RootNamespace>Parallax</RootNamespace>
    <!-- Interop assemblies generated by BepInEx from fixture F3 (fixtures\build.ps1 -Name F3, first launch). -->
    <InteropDir Condition="'$(InteropDir)' == ''">$(MSBuildThisFileDirectory)..\..\build\deps\interop-f3</InteropDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildThisFileDirectory)..\..\build\deps\bepinex6\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Parallax.Core\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(InteropDir)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>
</Project>
