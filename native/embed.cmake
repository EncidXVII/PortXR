# Writes `out`, a C++ file defining `const unsigned char <name>[]` and `const size_t <name>Size` for each NAME FILE pair:
# the app's fonts, built into the core so every engine's VR menu has them.
function(embed_files out)
    set(code "// Generated by native/embed.cmake from the app's assets. Do not edit.\n#include <cstddef>\n\n")
    set(args ${ARGN})
    list(LENGTH args n)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last} 2)
        math(EXPR j "${i} + 1")
        list(GET args ${i} name)
        list(GET args ${j} file)
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" chars)
        math(EXPR bytes "${chars} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
        string(APPEND code "extern const unsigned char ${name}[] = {${hex}};\nextern const size_t ${name}Size = ${bytes};\n\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    endforeach()
    file(WRITE "${out}.tmp" "${code}")
    file(COPY_FILE "${out}.tmp" "${out}" ONLY_IF_DIFFERENT)
    file(REMOVE "${out}.tmp")
endfunction()
